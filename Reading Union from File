#include <stdio.h>

union Employee
{
    int id;
    float salary;
};

int main()
{
    FILE *fp;
    union Employee e;

    fp = fopen("employee.dat", "rb");

    if(fp == NULL)
    {
        printf("File not found.");
        return 1;
    }

    fread(&e, sizeof(union Employee), 1, fp);

    printf("Employee ID = %d\n", e.id);

    fclose(fp);

    return 0;
}
