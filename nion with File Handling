#include <stdio.h>

union Employee
{
    int id;
    float salary;
};

int main()
{
    FILE *fp;
    union Employee e;

    e.id = 101;

    fp = fopen("employee.dat", "wb");

    if(fp == NULL)
    {
        printf("File cannot be opened.");
        return 1;
    }

    fwrite(&e, sizeof(union Employee), 1, fp);

    fclose(fp);

    printf("Data written successfully.");

    return 0;
}
Output
Data written successfully.
